#!/bin/bash

# Pre-push hook to prevent direct pushes to main/master branch
# This is a client-side hook that developers can install locally

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

protected_branches=('main' 'master')

current_branch=$(git symbolic-ref HEAD | sed -e 's,.*/\(.*\),\1,')

for branch in "${protected_branches[@]}"; do
    if [ "$current_branch" = "$branch" ]; then
        echo -e "${RED}========================================${NC}"
        echo -e "${RED}ERROR: Direct push to '$branch' branch is not allowed!${NC}"
        echo -e "${RED}========================================${NC}"
        echo ""
        echo -e "${YELLOW}Please create a feature branch instead:${NC}"
        echo ""
        echo "  git checkout -b feature/your-feature-name"
        echo "  git push -u origin feature/your-feature-name"
        echo ""
        echo "Then create a pull request on GitHub."
        echo ""
        exit 1
    fi
done

exit 0
